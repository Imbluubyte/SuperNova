var xs = [1, 2, 3, 4]
print(xs.map(fn(x) => x * 2))
var k = 10
fn makeAdder(n: Int) -> Fn(Int) -> Int:
	return fn(x) => x + n
var add5 = makeAdder(5)
print(add5(1), makeAdder(100)(1))
print(xs.reduce(0, fn(a, b) => a + b * k))
xs.each(fn(x) => print(x))
print(xs.any(fn(x) => x > 3), xs.all(fn(x) => x > 3))
var f: Fn(Int, Int) -> Int = fn(a, b) => a * b
print(f(6, 7))
var g = fn(s: String) => s + "!"
print(g("hi"))
class Counter:
	var count = 0
	var step = 2
	fn bump() -> Fn() -> Int:
		return fn() => count + step
	fn onCreation():
		count = 5
var c = Counter()
print(c.bump()())
fn apply(h: Fn(Int) -> Int, v: Int) -> Int:
	return h(v)
print(apply(fn(q) => q * q, 9))
var fs: List[Fn(Int) -> Int] = [fn(x) => x + 1, fn(x) => x * 3]
for h in fs:
	print(h(10))
var cb: Fn() = fn() => print("called")
cb()
fn double(x: Int) -> Int:
	return x * 2
print(xs.map(double))

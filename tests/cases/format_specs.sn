var x = 3.14159
var n = 42
var s = "hi"
print(f"[{x:.2f}] [{x:8.3f}] [{x:<8.1f}] [{x:^9.2f}]")
print(f"[{n:5}] [{n:05}] [{n:<5}] [{n:^6}] [{n:+d}] [{n:x}] [{n:X}] [{n:b}] [{n:o}]")
print(f"[{s:>6}] [{s:*^7}] [{s:<4}] [{s:.1}]")
print(f"[{n:.1f}] [{-n:06}] [{x:e}] [{true:>6}]")
var xs = [1, 2]
print(f"{xs[1]:3}|{xs.length():>3}")
